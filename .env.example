# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Realtime backend: "huggingface" (default) or "elevenlabs".
# REALTIME_BACKEND="huggingface"

# ElevenLabs Agents backend (used when REALTIME_BACKEND=elevenlabs). The app creates or updates
# the agent from the active profile before each session; the created agent ID is saved in the
# app instance directory unless ELEVENLABS_AGENT_ID is set. REALTIME_TRANSCRIPTION_LANGUAGE sets
# the agent language; non-English languages need a multilingual TTS model such as eleven_flash_v2_5.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_LLM="gemini-3.5-flash"
# ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"

# Hermes backend (REALTIME_BACKEND=hermes): a local wake word starts a conversation; ElevenLabs
# Scribe transcribes, a Hermes Agent API server answers, ElevenLabs TTS speaks. Needs
# `pip install openwakeword` (extra: hermes) plus ELEVENLABS_API_KEY and a voice. Nothing is
# streamed or billed while waiting for the wake word.
# HERMES_BASE_URL="http://127.0.0.1:8642/v1"
# HERMES_API_KEY=
# HERMES_MODEL="reachy"
# WAKE_WORD="hey_jarvis"               # openWakeWord model name, a custom .onnx model, or an Edge Impulse .eim
# WAKE_WORD_THRESHOLD=0.5
# WAKE_PHRASE="hey reachy|hei richie"  # spellings stripped from transcripts (|-separated) for model files
# WAKE_WORD_VAD_THRESHOLD=0.5         # openWakeWord only: ignore wakes when Silero VAD hears no speech (0 = off)
# WAKE_WORD_SAVE_CLIPS=1              # save 2.5 s of audio per wake to <instance>/wake_clips (last 200) for review
# WAKE_ACK_TEXT="Da?"                  # spoken on wake; empty disables it
# CONVERSATION_TIMEOUT_S=5             # seconds (1-30) of silence before wake-word mode; set_listening_time tool
# STT_VAD_SILENCE_S=0.6                # pause that ends an utterance
# BARGE_IN=1                           # talking over the robot interrupts it
# TTS_GAIN=1.0                         # optional loudness multiplier for TTS audio (1.0 = unchanged)
# ELEVENLABS_TTS_MODEL="eleven_v4_turbo"
# Robot tools for Hermes: with a token set, the app serves selected robot tools (volume, emotions,
# dances, head moves) over MCP at http://<robot>:ROBOT_MCP_PORT/mcp; register that URL and token
# in the Hermes profile's mcp_servers.
# ROBOT_MCP_TOKEN=
# ROBOT_MCP_PORT=8766
# ROBOT_MCP_HOST=0.0.0.0
# Optional always-on relay (robot_mcp_relay, e.g. as a systemd user service): keeps the MCP port
# open while Reachy sleeps, so Hermes never drops the tools. With the relay, set ROBOT_MCP_PORT=8767
# and ROBOT_MCP_HOST=127.0.0.1 for the app; the relay listens on ROBOT_MCP_RELAY_PORT.
# ROBOT_MCP_RELAY_PORT=8766
# ROBOT_MCP_TOOLS="volume_control,play_emotion,stop_emotion,dance,stop_dance,move_head,sweep_look,head_tracking,robot_status"
# With the Hermes backend the robot MCP server also offers set_timer/set_alarm/list_alarms/cancel_alarm
# (ringing on the robot, saved in alarms.json in the instance directory) and web_search/get_weather/get_time.
# ALARM_TIMEZONE="Europe/Berlin"      # IANA timezone for alarms; defaults to the system timezone
# WEATHER_LOCATION="Frankfurt am Main, Germany"     # default place for get_weather (Open-Meteo, no key);
#                                     # extra comma parts disambiguate by region or country
# NEWS_FEEDS_FILE=                     # JSON list of {name, url, topic, language} RSS/Atom feeds; default
#                                     # <instance>/news_feeds.json, seeded with Digi24, G4Media, Tagesschau,
#                                     # Hessenschau and BBC World; editable via the add/remove_news_source tools
# Home Assistant administration via ha-mcp (https://github.com/homeassistant-ai/ha-mcp), full
# Streamable HTTP endpoint incl. its secret path. Reads go through <url>/readonly; writes only while
# "engineering mode" is on (voice tool set_engineering_mode). It switches off after the minutes below
# without activity; every request to Reachy and every Home Assistant tool call restarts the timer.
# HA_MCP_URL=http://<hermes-host>:8086/private_<secret>
# ENGINEERING_MODE_TIMEOUT_MIN=15
# Device control without engineering mode: lights, switches, covers, fans, climate, media, scenes,
# humidifiers, input_booleans. Entities matching this regex always need engineering mode:
# HA_PROTECTED_PATTERN="valve|lock|alarm|garage|siren|heater|pump"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Antenna sleep gesture: during the idle animation, push an antenna down; it gives way (no fighting the
# motor) and, once it reaches the down position and stays there briefly, Reachy goes to sleep.
# Never triggers during emotions, dances, listening or speech. Works in every backend.
# ANTENNA_SLEEP_GESTURE=1
# ANTENNA_SLEEP_DOWN_RAD=0.6           # down position to reach (rad from straight; idle sway stays within ~0.27)
# ANTENNA_SLEEP_HOLD_S=0.3             # how long it must stay there
