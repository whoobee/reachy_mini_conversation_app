# ~/.hermes/profiles/reachy/.env on the Hermes host (never commit the real file)
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8643
# Key the robot uses for this profile (HERMES_API_KEY in the robot app's .env)
API_SERVER_KEY=
# Home Assistant: URL and a long-lived access token
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=
# Same value as ROBOT_MCP_TOKEN in the robot app's .env
ROBOT_MCP_TOKEN=
